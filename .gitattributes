# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-native files keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# Makefiles require literal tabs; never let a filter touch them.
Makefile text eol=lf

# Binary assets: no line-ending or diff mangling.
*.png binary
*.jpg binary
*.pdf binary
*.joblib binary
*.pkl binary
*.npy binary
*.npz binary
*.parquet binary

# Notebooks are JSON. Diff them as text, but keep them out of language stats
# and collapse them in pull-request reviews.
*.ipynb text linguist-documentation diff=jupyter

# GitHub language statistics should reflect the package, not the study outputs.
docs/** linguist-documentation
experiments/** linguist-documentation

# Files that do not belong in a source distribution or archive.
.github/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.pre-commit-config.yaml export-ignore
tests/ export-ignore
