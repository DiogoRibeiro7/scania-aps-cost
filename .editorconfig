root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,toml,cff}]
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.ipynb]
# Notebooks are machine-generated JSON; leave their formatting alone.
indent_size = 1
trim_trailing_whitespace = false
insert_final_newline = false
